
units metal
atom_style molecular
boundary s s s    #non-periodic

# System definition
read_data c60_ratchetOP.data

# set groups
group free type 1 2
group anchor type  3 4
group negx type  5 

# Pair Coefficients
pair_style	airebo 3.0 1 0
pair_coeff * * CH.airebo C H C H C 

#freeze the jig atoms atoms
fix anchorfix anchor setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity anchor set 0.0 0.0 0.0

fix input2fix negx setforce 0.0 0.0 0.0 #first is ID = user-assigned name for the fix,  ID of the group of atoms
velocity negx set 0.0 0.0 0.0

#Minimize before bringing to temperature

minimize 1.0e-4 1.0e-6 1000 10000

# Equilibrate to 90K
fix nve all nve
timestep 0.00025

# bring the temp of all free atoms to 90K
fix freefix free temp/berendsen 90. 90. 0.25

# Per-atom computes so OVITO can color by energy/stress
# pe/atom      -> potential energy per atom (eV)
# stress/atom  -> per-atom stress*volume tensor (bar*Ang^3), 6 components: xx yy zz xy xz yz
#                 NULL = no bias-removed temperature compute needed for this
compute peratom all pe/atom
compute stratom all stress/atom NULL

#output
dump mounted_wheel_dump all custom 40 bring_to_temp_c60rotor.lammpstrj &
     id type x y z c_peratom c_stratom[1] c_stratom[2] c_stratom[3] c_stratom[4] c_stratom[5] c_stratom[6]
dump_modify mounted_wheel_dump sort id

thermo 100 #print thermo data to the terminal every 100 steps
run 4000 #4000
write_restart TEMP_c60ratchetOP.init.restart
